# 巨量广告后台或新建广告入口地址。后续你给我准确 URL 后填这里。
JULIANG_BASE_URL=https://ad.oceanengine.com/
JULIANG_LOGIN_URL=https://ad.oceanengine.com/pages/login/index.html
JULIANG_CREATE_AD_URL_TEMPLATE=https://ad.oceanengine.com/ad/web/std/ad/create?aadvid={account_id}&campaign_type=1

# Playwright 持久化登录态目录。不要提交或分享这个目录。
JULIANG_USER_DATA_DIR=.auth/juliang-chrome

# headed=true 会显示浏览器，便于手动登录和调试。
JULIANG_HEADLESS=false
JULIANG_SLOW_MO_MS=80
JULIANG_TIMEOUT_MS=30000
